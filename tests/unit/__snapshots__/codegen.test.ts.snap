            <type><derived name="R_TRIG"/></type>
          </variable>
        </localVars>
      </interface>
      <body><ST><xhtml:p><![CDATA[RE_1(CLK := reset);
SIG_1 := RE_1.Q;]]></xhtml:p></ST></body>
    </pou>
    <pou name="G1" pouType="program">
      <interface>
        <externalVars>
          <variable name="reset">
            <type><BOOL/></type>
          </variable>
          <variable name="level">
            <type><REAL/></type>
          </variable>
          <variable name="C">
            <type><INT/></type>
          </variable>
          <variable name="Speed">
            <type><REAL/></type>
          </variable>
          <variable name="Delay">
            <type><TIME/></type>
          </variable>
          <variable name="Motor">
            <type><BOOL/></type>
          </variable>
          <variable name="Done">
            <type><BOOL/></type>
          </variable>
          <variable name="SIG_1">
            <type><BOOL/></type>
          </variable>
        </externalVars></interface>
      <body>
        <SFC>
          <step localId="1" name="G1_X0" initialStep="true" height="40" width="40"><position x="-20" y="-20"/><connectionPointOut formalParameter="sfc"><relPosition x="20" y="40"/></connectionPointOut><connectionPointOutAction formalParameter=""><relPosition x="40" y="20"/></connectionPointOutAction></step>
          <step localId="2" name="G1_X1" initialStep="false" height="40" width="40"><position x="-20" y="100"/><connectionPointIn><relPosition x="20" y="0"/><connection refLocalId="3"/></connectionPointIn><connectionPointOut formalParameter="sfc"><relPosition x="20" y="40"/></connectionPointOut><connectionPointOutAction formalParameter=""><relPosition x="40" y="20"/></connectionPointOutAction></step>
          <transition localId="3" height="2" width="20"><position x="-10" y="59"/><connectionPointIn><relPosition x="10" y="0"/><connection refLocalId="1"/></connectionPointIn><connectionPointOut><relPosition x="10" y="2"/></connectionPointOut><condition><inline name=""><ST><xhtml:p><![CDATA[(level > 80.5) OR (C = 3)]]></xhtml:p></ST></inline></condition></transition>
          <transition localId="4" height="2" width="20"><position x="-10" y="179"/><connectionPointIn><relPosition x="10" y="0"/><connection refLocalId="2"/></connectionPointIn><connectionPointOut><relPosition x="10" y="2"/></connectionPointOut><condition><inline name=""><ST><xhtml:p><![CDATA[((C + 1) MOD 2 = 0) AND Done]]></xhtml:p></ST></inline></condition></transition>
          <jumpStep localId="5" targetName="G1_X0" height="13" width="12"><position x="-6" y="205"/><connectionPointIn><relPosition x="6" y="0"/><connection refLocalId="4"/></connectionPointIn></jumpStep>
          <actionBlock localId="11" width="160" height="100"><position x="40" y="110"/><connectionPointIn><relPosition x="0" y="10"/><connection refLocalId="2"/></connectionPointIn><action localId="6" qualifier="P1"><relPosition x="0" y="0"/><inline><ST><xhtml:p><![CDATA[C := C + 1;]]></xhtml:p></ST></inline></action><action localId="7" qualifier="S"><relPosition x="0" y="20"/><reference name="Motor"/></action><action localId="8" qualifier="P0"><relPosition x="0" y="40"/><inline><ST><xhtml:p><![CDATA[Motor := FALSE;]]></xhtml:p></ST></inline></action><action localId="9" qualifier="N"><relPosition x="0" y="60"/><inline><ST><xhtml:p><![CDATA[IF SIG_1 THEN C := 0; END_IF;]]></xhtml:p></ST></inline></action><action localId="10" qualifier="P1"><relPosition x="0" y="80"/><inline><ST><xhtml:p><![CDATA[IF level < 10 THEN Speed := Speed * 2.0; END_IF;]]></xhtml:p></ST></inline></action></actionBlock>
          <actionBlock localId="13" width="160" height="20"><position x="40" y="-10"/><connectionPointIn><relPosition x="0" y="10"/><connection refLocalId="1"/></connectionPointIn><action localId="12" qualifier="P1"><relPosition x="0" y="0"/><inline><ST><xhtml:p><![CDATA[Done := (C >= 3) AND NOT reset;]]></xhtml:p></ST></inline></action></actionBlock>
        </SFC>
      </body>
    </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Resource">
          <task name="MainTask" priority="1" interval="T#10ms">
            <pouInstance name="GRAFCET_Signals_Instance" typeName="GRAFCET_Signals"/>
            <pouInstance name="G1_Instance" typeName="G1"/>
          </task>
          <globalVars>
            <variable name="reset">
              <type><BOOL/></type>
            </variable>
            <variable name="level">
              <type><REAL/></type>
            </variable>
            <variable name="C">
              <type><INT/></type>
              <initialValue><simpleValue value="2"/></initialValue>
            </variable>
            <variable name="Speed">
              <type><REAL/></type>
              <initialValue><simpleValue value="1.5"/></initialValue>
            </variable>
            <variable name="Delay">
              <type><TIME/></type>
              <initialValue><simpleValue value="T#1m30s500ms"/></initialValue>
            </variable>
            <variable name="Motor">
              <type><BOOL/></type>
            </variable>
            <variable name="Done">
              <type><BOOL/></type>
            </variable>
            <variable name="SIG_1">
              <type><BOOL/></type>
              <documentation><xhtml:p><![CDATA[↑(reset)]]></xhtml:p></documentation>
            </variable>
          </globalVars>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
"
`;

