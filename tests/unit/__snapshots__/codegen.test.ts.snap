exports[`Structured Text, CASE style > stored actions, comparisons and types 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one INT variable per sequence holds the number of its active step. Its CASE runs
  the transitions of that step only, so a sequence clears at most one transition per scan and,
  of alternative branches, the first true receptivity (left to right) wins. Stored actions run
  in the transition that activates or deactivates their step; an active forcing order replaces
  the CASE of the grafcet it forces.
  Timers and edges are updated at the start of the scan. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
	level : REAL;
	reset : BOOL;
END_VAR
VAR_OUTPUT
	Motor : BOOL;
	Speed : REAL := 1.5;
END_VAR
VAR
	C : INT := 2;
	Delay : TIME := T#1m30s500ms;
	Done : BOOL;
END_VAR
VAR	// GRAFCET state
	step_G1 : INT := 0;	// G1: number of the active step
	step_G1_range_error : BOOL;	// step_G1 holds no step of G1
	Init : BOOL := TRUE;	// first scan
	RE_reset : R_TRIG;	// ↑reset
END_VAR

// Timers and edges
RE_reset(CLK := reset);

// First scan: actions on activation of the initial steps
IF Init THEN
	Done := C >= 3 AND NOT reset;
END_IF;

// G1
CASE step_G1 OF
	0:
		IF level > 80.5 OR C = 3 THEN
			step_G1 := 1;
			C := C + 1;
			Motor := TRUE;
			IF level < 10 THEN
				Speed := Speed * 2.0;
			END_IF;
		END_IF;
	1:
		IF (C + 1) MOD 2 = 0 AND Done THEN
			Motor := FALSE;
			step_G1 := 0;
			Done := C >= 3 AND NOT reset;
		END_IF;
	ELSE
		step_G1_range_error := TRUE;
END_CASE;

// Actions on events
IF step_G1 = 1 AND RE_reset.Q THEN
	C := 0;
END_IF;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text, CASE style > timers and edges 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
