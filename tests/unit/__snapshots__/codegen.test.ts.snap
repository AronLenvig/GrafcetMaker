END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND ((level > 80.5) OR (C = 3));   (* 0 → 1: (level > 80.5) + (C = 3) *)
G1_T2 := G1_X1 AND ((C + 1) MOD 2 = 0) AND Done;   (* 1 → 0: ((C + 1) MOD 2 = 0) * Done *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T2 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)

(* Timers and edges (seen by the transitions of the next scan) *)
RE_1(CLK := reset);

(* Stored actions *)
IF NOT G1_X1 AND G1_X1_M THEN   (* G1 step 1, on deactivation: Motor := 0 *)
    Motor := FALSE;
END_IF;
IF G1_X1 AND NOT G1_X1_M THEN   (* G1 step 1, on activation: C := C + 1 *)
    C := C + 1;
END_IF;
IF G1_X1 AND NOT G1_X1_M THEN   (* G1 step 1, on activation: Motor := 1 *)
    Motor := TRUE;
END_IF;
IF G1_X1 AND NOT G1_X1_M AND (level < 10) THEN   (* G1 step 1, on activation: Speed := Speed * 2 *)
    Speed := Speed * 2.0;
END_IF;
IF G1_X0 AND NOT G1_X0_M THEN   (* G1 step 0, on activation: Done := (C >= 3) * /reset *)
    Done := (C >= 3) AND NOT reset;
END_IF;
IF G1_X1 AND RE_1.Q THEN   (* G1 step 1, on event: C := 0 *)
    C := 0;
END_IF;
G1_X0_M := G1_X0;
G1_X1_M := G1_X1;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text > timers and edges 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    b : BOOL;
END_VAR
VAR_OUTPUT
    Horn : BOOL;
    Lamp : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    G1_X0 : BOOL;   (* G1 step 0, initial *)
    G1_X1 : BOOL;   (* G1 step 1 *)
    G1_X2 : BOOL;   (* G1 step 2 *)
    G1_T1 : BOOL;
    G1_T2 : BOOL;
    G1_T3 : BOOL;
    RE_1 : R_TRIG;   (* ↑b *)
    TON_1 : TON;   (* T#5s after G1_X1 *)
    FE_1 : F_TRIG;   (* ↓b *)
    TON_2 : TON;   (* T#2s after b *)
    TOF_2 : TOF;   (* held T#1m30s *)
    TON_3 : TON;   (* T#500ms after G1_X1 *)
    TON_4 : TON;   (* T#3s after G1_X2 *)
END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND RE_1.Q;   (* 0 → 1: ↑b *)
G1_T2 := G1_X1 AND (TON_1.Q OR FE_1.Q);   (* 1 → 2: 5s/X1 + ↓b *)
G1_T3 := G1_X2 AND TOF_2.Q;   (* 2 → 0: 2s/b/90s *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T3 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)
G1_X2 := (G1_X2 AND NOT G1_T3) OR G1_T2;   (* G1 step 2 *)

(* Timers and edges (seen by the transitions of the next scan) *)
RE_1(CLK := b);
TON_1(IN := G1_X1, PT := T#5s);
FE_1(CLK := b);
TON_2(IN := b, PT := T#2s);
TOF_2(IN := TON_2.Q, PT := T#1m30s);
TON_3(IN := G1_X1, PT := T#500ms);
TON_4(IN := G1_X2, PT := T#3s);

(* Continuous actions *)
Lamp := G1_X1 AND TON_3.Q;
Horn := G1_X2 AND NOT TON_4.Q;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text, CASE style > AND divergence and convergence 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one BOOL per step, X := (X AND NOT out) OR in,
  with every transition computed from the situation at the start of the scan.
  Timers and edges are updated at the start of the scan. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
	d1 : BOOL;
	d2 : BOOL;
	go : BOOL;
END_VAR
VAR_OUTPUT
	Clamp : BOOL;
	Drill : BOOL;
END_VAR
VAR	// GRAFCET state
	G1_X0 : BOOL := TRUE;	// G1 step 0
	G1_X1 : BOOL;	// G1 step 1
	G1_X2 : BOOL;	// G1 step 2
	G1_X3 : BOOL;	// G1 step 3
	G1_T1 : BOOL;
	G1_T2 : BOOL;
	G1_T3 : BOOL;
END_VAR

// G1: one BOOL per step
G1_T1 := G1_X0 AND go;	// 0 → 1, 2
G1_T2 := G1_X1 AND G1_X2 AND d1 AND d2;	// 1, 2 → 3
G1_T3 := G1_X3;	// 3 → 0
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T3;
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;
G1_X2 := (G1_X2 AND NOT G1_T2) OR G1_T1;
G1_X3 := (G1_X3 AND NOT G1_T3) OR G1_T2;

// Outputs
Drill := G1_X1;
Clamp := G1_X2;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text, CASE style > OR divergence and convergence 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one INT variable per sequence holds the number of its active step. Its CASE runs
  the transitions of that step only, so a sequence clears at most one transition per scan and,
  of alternative branches, the first true receptivity (left to right) wins. Stored actions run
  in the transition that activates or deactivates their step; an active forcing order replaces
  the CASE of the grafcet it forces.
  Timers and edges are updated at the start of the scan. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
	a : BOOL;
	b : BOOL;
	c : BOOL;
END_VAR
VAR	// GRAFCET state
	step_G1 : INT := 0;	// G1: number of the active step
	step_G1_range_error : BOOL;	// step_G1 holds no step of G1
END_VAR

// G1
CASE step_G1 OF
	0:
		IF a THEN
			step_G1 := 1;
		ELSIF NOT a AND b THEN
			step_G1 := 2;
		END_IF;
	1:
		IF c THEN
			step_G1 := 3;
		END_IF;
	2:
		IF c THEN
			step_G1 := 3;
		END_IF;
	3:
		step_G1 := 0;
	ELSE
		step_G1_range_error := TRUE;
END_CASE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text, CASE style > enclosing step 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one INT variable per sequence holds the number of its active step. Its CASE runs
  the transitions of that step only, so a sequence clears at most one transition per scan and,
  of alternative branches, the first true receptivity (left to right) wins. Stored actions run
  in the transition that activates or deactivates their step; an active forcing order replaces
  the CASE of the grafcet it forces.
  Sequences with parallel branches keep one BOOL per step, X := (X AND NOT out) OR in,
  with every transition computed from the situation at the start of the scan.
  Timers and edges are updated at the start of the scan. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
	auto : BOOL;
	b : BOOL;
END_VAR
VAR	// GRAFCET state
	step_Modes : INT := 0;	// Modes: number of the active step
	step_Modes_range_error : BOOL;	// step_Modes holds no step of Modes
	Auto_X20 : BOOL;	// Auto step 20
	Auto_X21 : BOOL;	// Auto step 21
	Auto_T1 : BOOL;
	Auto_T2 : BOOL;
	Modes_X1_M : BOOL;	// step 1 active in the previous scan
END_VAR

// Modes
CASE step_Modes OF
	0:
		IF auto THEN
			step_Modes := 1;
		END_IF;
	1:
		IF NOT auto THEN
			step_Modes := 0;
		END_IF;
	ELSE
		step_Modes_range_error := TRUE;
END_CASE;

// Auto: one BOOL per step
Auto_T1 := Auto_X20 AND b AND step_Modes = 1;	// 20 → 21
Auto_T2 := Auto_X21 AND NOT b AND step_Modes = 1;	// 21 → 20
Auto_X20 := ((Auto_X20 AND NOT Auto_T1) OR Auto_T2) AND step_Modes = 1 OR (step_Modes = 1 AND NOT Modes_X1_M);
Auto_X21 := ((Auto_X21 AND NOT Auto_T2) OR Auto_T1) AND step_Modes = 1;

// Step activity of this scan, for the next one
Modes_X1_M := step_Modes = 1;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text, CASE style > forcing orders 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one INT variable per sequence holds the number of its active step. Its CASE runs
  the transitions of that step only, so a sequence clears at most one transition per scan and,
  of alternative branches, the first true receptivity (left to right) wins. Stored actions run
  in the transition that activates or deactivates their step; an active forcing order replaces
  the CASE of the grafcet it forces.
  Timers and edges are updated at the start of the scan. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
	run : BOOL;
	stop : BOOL;
END_VAR
VAR	// GRAFCET state
	step_Safety : INT := 0;	// Safety: number of the active step
	step_Safety_range_error : BOOL;	// step_Safety holds no step of Safety
	step_Cycle : INT := 10;	// Cycle: number of the active step
	step_Cycle_range_error : BOOL;	// step_Cycle holds no step of Cycle
END_VAR

// Safety
CASE step_Safety OF
	0:
		IF stop THEN
			step_Safety := 1;
		END_IF;
	1:
		IF NOT stop THEN
			step_Safety := 2;
		END_IF;
	2:
		step_Safety := 3;
	3:
		IF run THEN
			step_Safety := 0;
		END_IF;
	ELSE
		step_Safety_range_error := TRUE;
END_CASE;

// Cycle
IF step_Safety = 3 THEN	// Cycle{INIT}
	step_Cycle := 10;
ELSIF step_Safety = 2 THEN	// Cycle{*}
	;	// frozen
ELSIF step_Safety = 1 THEN	// Cycle{11}
	step_Cycle := 11;
ELSE
	CASE step_Cycle OF
		10:
			IF run THEN
				step_Cycle := 11;
			END_IF;
		11:
			IF NOT run AND (step_Safety = 1) THEN
				step_Cycle := 10;
			END_IF;
		ELSE
			step_Cycle_range_error := TRUE;
	END_CASE;
END_IF;

END_FUNCTION_BLOCK
"
`;

