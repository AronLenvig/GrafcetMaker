	0:
		IF #level > 80.5 OR #C = 3 THEN
			#step_G1 := 1;
			#C := #C + 1;
			#Motor := TRUE;
			IF #level < 10 THEN
				#Speed := #Speed * 2.0;
			END_IF;
		END_IF;
