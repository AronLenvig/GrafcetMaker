// Cloudflare Workers deployment of the public site: the built app (dist/) as static assets plus the
// anonymous feedback endpoint (worker/index.ts). Build with `npm run build`, deploy with
// `npx wrangler deploy` (Workers Builds runs both on every push).
// The feedback issues go to GITHUB_REPO; the token is a secret set in the dashboard (Worker ›
// Settings › Variables and Secrets, or `npx wrangler secret put GITHUB_TOKEN`), never here.
// Secrets survive deploys, plain variables only when they are in this file.
// Self-hosted and on-premise installs do not need this file.
{
  "name": "grafcetmaker",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "vars": { "GITHUB_REPO": "AronLenvig/grafcetmaker-feedback" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
