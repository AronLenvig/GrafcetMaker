exports[`Structured Text > stability loop variant 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: within each scan, transitions are cleared repeatedly until the situation is stable
  (at most 1000 iterations, see Unstable). Edges are true in the first iteration only.

  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    empty : BOOL;
    full : BOOL;
    start : BOOL;   (* %I0.0 · Start button *)
END_VAR
VAR_OUTPUT
    Pump : BOOL;   (* %Q0.0 *)
    Valve : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    Iter : INT;
    Changed : BOOL;
    Next : BOOL;
    Unstable : BOOL;   (* the last search for stability hit 1000 iterations *)
    G1_X0 : BOOL;   (* G1 step 0, initial *)
    G1_X1 : BOOL;   (* G1 step 1 *)
    G1_X2 : BOOL;   (* G1 step 2 *)
    G1_T1 : BOOL;
    G1_T2 : BOOL;
    G1_T3 : BOOL;
END_VAR

(* Initial situation *)
IF Init THEN
    G1_X0 := TRUE;
END_IF;

(* Search for stability: clear transitions until the situation no longer changes *)
Iter := 0;
REPEAT
    Changed := FALSE;

    (* Transitions: enabled and receptivity true *)
    G1_T1 := G1_X0 AND start;   (* 0 → 1: start *)
    G1_T2 := G1_X1 AND full;   (* 1 → 2: full *)
    G1_T3 := G1_X2 AND empty;   (* 2 → 0: empty *)

    (* Steps: activated by an incoming transition, deactivated by an outgoing one *)
    Next := (G1_X0 AND NOT G1_T1) OR G1_T3;   (* G1 step 0 *)
    Changed := Changed OR (Next <> G1_X0);
    G1_X0 := Next;
    Next := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)
    Changed := Changed OR (Next <> G1_X1);
    G1_X1 := Next;
    Next := (G1_X2 AND NOT G1_T3) OR G1_T2;   (* G1 step 2 *)
    Changed := Changed OR (Next <> G1_X2);
    G1_X2 := Next;
    Iter := Iter + 1;
UNTIL NOT Changed OR Iter >= 1000
END_REPEAT;
Unstable := Changed;   (* TRUE: the evolution did not become stable *)

(* Continuous actions *)
Pump := G1_X1;
Valve := G1_X2;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

