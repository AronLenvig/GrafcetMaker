			#step_G1 := 0;
			#Done := #C >= 3 AND NOT #reset;
		END_IF;
	ELSE
		#step_G1_range_error := TRUE;
END_CASE;

// Actions on events
IF #step_G1 = 1 AND #RE_reset.Q THEN
	#C := 0;
END_IF;

