VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    G1_X0 : BOOL;   (* G1 step 0, initial *)
    G1_X0_M : BOOL;   (* activity at the previous scan *)
    G1_X1 : BOOL;   (* G1 step 1 *)
    G1_X1_M : BOOL;   (* activity at the previous scan *)
    G1_T1 : BOOL;
    G1_T2 : BOOL;
    RE_1 : R_TRIG;   (* ↑reset *)
END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND ((level > 80.5) OR (C = 3));   (* 0 → 1: (level > 80.5) + (C = 3) *)
G1_T2 := G1_X1 AND ((C + 1) MOD 2 = 0) AND Done;   (* 1 → 0: ((C + 1) MOD 2 = 0) * Done *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T2 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)

(* Timers and edges (seen by the transitions of the next scan) *)
RE_1(CLK := reset);

(* Stored actions *)
IF NOT G1_X1 AND G1_X1_M THEN   (* G1 step 1, on deactivation: Motor := 0 *)
    Motor := FALSE;
END_IF;
IF G1_X1 AND NOT G1_X1_M THEN   (* G1 step 1, on activation: C := C + 1 *)
    C := C + 1;
END_IF;
IF G1_X1 AND NOT G1_X1_M AND (level < 10) THEN   (* G1 step 1, on activation: Speed := Speed * 2 *)
    Speed := Speed * 2.0;
END_IF;
IF G1_X0 AND NOT G1_X0_M THEN   (* G1 step 0, on activation: Done := (C >= 3) * /reset *)
    Done := (C >= 3) AND NOT reset;
END_IF;
IF G1_X1 THEN   (* G1 step 1, while active: Motor := 1 *)
    Motor := TRUE;
END_IF;
IF G1_X1 AND RE_1.Q THEN   (* G1 step 1, on event: C := 0 *)
    C := 0;
END_IF;
G1_X0_M := G1_X0;
G1_X1_M := G1_X1;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`vendor dialects > one BOOL per step in Logix: initial values on the first scan 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated - review before use
  2026-01-02 03:04 UTC - revision B - QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this routine every scan.

  Studio 5000 Logix Designer: create these tags (program scope), then paste the code
  below into a Structured Text routine called every scan.

  Name     Data type    Use     Comment
  level    REAL         input
  reset    BOOL         input
  Motor    BOOL         output
  Speed    REAL         output
  C        DINT         local
  Delay    DINT         local
  Done     BOOL         local
  Init     BOOL         local   first scan
  G1_X0    BOOL         local   G1 step 0, initial
  G1_X0_M  BOOL         local   activity at the previous scan
  G1_X1    BOOL         local   G1 step 1
  G1_X1_M  BOOL         local   activity at the previous scan
  G1_T1    BOOL         local
  G1_T2    BOOL         local
  RE_1     FBD_ONESHOT  local   RE reset
*)

// First scan: initial values
IF S:FS THEN
    Motor := 0;
    Speed := 1.5;
    C := 2;
    Delay := 90500;
    Done := 0;
    Init := 1;
    G1_X0 := 0;
    G1_X0_M := 0;
    G1_X1 := 0;
    G1_X1_M := 0;
    G1_T1 := 0;
    G1_T2 := 0;
END_IF;

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND ((level > 80.5) OR (C = 3));   (* 0 -> 1: (level > 80.5) + (C = 3) *)
G1_T2 := G1_X1 AND ((C + 1) MOD 2 = 0) AND Done;   (* 1 -> 0: ((C + 1) MOD 2 = 0) * Done *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T2 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)

(* Timers and edges (seen by the transitions of the next scan) *)
RE_1.InputBit := reset;
OSRI(RE_1);

(* Stored actions *)
IF NOT G1_X1 AND G1_X1_M THEN   (* G1 step 1, on deactivation: Motor := 0 *)
    Motor := 0;
END_IF;
IF G1_X1 AND NOT G1_X1_M THEN   (* G1 step 1, on activation: C := C + 1 *)
    C := C + 1;
END_IF;
IF G1_X1 AND NOT G1_X1_M THEN   (* G1 step 1, on activation: Motor := 1 *)
    Motor := 1;
END_IF;
IF G1_X1 AND NOT G1_X1_M AND (level < 10) THEN   (* G1 step 1, on activation: Speed := Speed * 2 *)
    Speed := Speed * 2.0;
END_IF;
IF G1_X0 AND NOT G1_X0_M THEN   (* G1 step 0, on activation: Done := (C >= 3) * /reset *)
    Done := (C >= 3) AND NOT reset;
END_IF;
IF G1_X1 AND RE_1.OutputBit THEN   (* G1 step 1, on event: C := 0 *)
    C := 0;
END_IF;
G1_X0_M := G1_X0;
G1_X1_M := G1_X1;

Init := 0;
"
`;

exports[`vendor dialects > rockwell 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated - review before use
  2026-01-02 03:04 UTC - revision B - QA

  Execution: one INT variable per sequence holds the number of its active step. Its CASE runs
  the transitions of that step only, so a sequence clears at most one transition per scan and,
  of alternative branches, the first true receptivity (left to right) wins. Stored actions run
  in the transition that activates or deactivates their step; an active forcing order replaces
  the CASE of the grafcet it forces.
  Timers and edges are updated at the start of the scan. Call this routine every scan.

  Studio 5000 Logix Designer: create these tags (program scope), then paste the code
  below into a Structured Text routine called every scan.

  Name                 Data type    Use     Comment
  b                    BOOL         input
  Horn                 BOOL         output
  Lamp                 BOOL         output
  step_G1              DINT         local   G1: number of the active step
  step_G1_range_error  BOOL         local   step_G1 holds no step of G1
  RE_b                 FBD_ONESHOT  local   RE b
  TON_G1_X1            FBD_TIMER    local   T#5s after step_G1 = 1
  FE_b                 FBD_ONESHOT  local   FE b
  TON_b                FBD_TIMER    local   T#2s after b
  TOF_b                FBD_TIMER    local   held T#1m30s
  TON_G1_X1_2          FBD_TIMER    local   T#500ms after step_G1 = 1
  TON_G1_X2            FBD_TIMER    local   T#3s after step_G1 = 2
*)

// First scan: initial values
IF S:FS THEN
	Horn := 0;
	Lamp := 0;
	step_G1 := 0;
	step_G1_range_error := 0;
END_IF;

// Timers and edges
RE_b.InputBit := b;
OSRI(RE_b);
TON_G1_X1.PRE := 5000;
TON_G1_X1.TimerEnable := step_G1 = 1;
TONR(TON_G1_X1);
FE_b.InputBit := b;
OSFI(FE_b);
TON_b.PRE := 2000;
TON_b.TimerEnable := b;
TONR(TON_b);
TOF_b.PRE := 90000;
TOF_b.TimerEnable := TON_b.DN;
TOFR(TOF_b);
TON_G1_X1_2.PRE := 500;
TON_G1_X1_2.TimerEnable := step_G1 = 1;
TONR(TON_G1_X1_2);
TON_G1_X2.PRE := 3000;
TON_G1_X2.TimerEnable := step_G1 = 2;
TONR(TON_G1_X2);

// G1
CASE step_G1 OF
	0:
		IF RE_b.OutputBit THEN
			step_G1 := 1;
		END_IF;
	1:
		IF TON_G1_X1.DN OR FE_b.OutputBit THEN
			step_G1 := 2;
		END_IF;
	2:
		IF TOF_b.DN THEN
			step_G1 := 0;
		END_IF;
	ELSE
		step_G1_range_error := 1;
END_CASE;

// Outputs
Lamp := step_G1 = 1 AND TON_G1_X1_2.DN;
Horn := step_G1 = 2 AND NOT TON_G1_X2.DN;
"
`;

