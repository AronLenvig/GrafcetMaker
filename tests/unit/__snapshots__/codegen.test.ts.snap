exports[`Structured Text > AND divergence and convergence 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    d1 : BOOL;
    d2 : BOOL;
    go : BOOL;
END_VAR
VAR_OUTPUT
    Clamp : BOOL;
    Drill : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    G1_X0 : BOOL;   (* G1 step 0, initial *)
    G1_X1 : BOOL;   (* G1 step 1 *)
    G1_X2 : BOOL;   (* G1 step 2 *)
    G1_X3 : BOOL;   (* G1 step 3 *)
    G1_T1 : BOOL;
    G1_T2 : BOOL;
    G1_T3 : BOOL;
END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND go;   (* 0 → 1, 2: go *)
G1_T2 := G1_X1 AND G1_X2 AND d1 AND d2;   (* 1, 2 → 3: d1 * d2 *)
G1_T3 := G1_X3;   (* 3 → 0: 1 *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT G1_T1) OR G1_T3 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T2) OR G1_T1;   (* G1 step 1 *)
G1_X2 := (G1_X2 AND NOT G1_T2) OR G1_T1;   (* G1 step 2 *)
G1_X3 := (G1_X3 AND NOT G1_T3) OR G1_T2;   (* G1 step 3 *)

(* Continuous actions *)
Drill := G1_X1;
Clamp := G1_X2;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text > OR divergence and convergence 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    a : BOOL;
    b : BOOL;
    c : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    G1_X0 : BOOL;   (* G1 step 0, initial *)
    G1_X1 : BOOL;   (* G1 step 1 *)
    G1_X2 : BOOL;   (* G1 step 2 *)
    G1_X3 : BOOL;   (* G1 step 3 *)
    G1_T1 : BOOL;
    G1_T2 : BOOL;
    G1_T3 : BOOL;
    G1_T4 : BOOL;
    G1_T5 : BOOL;
END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
G1_T1 := G1_X0 AND a;   (* 0 → 1: a *)
G1_T2 := G1_X0 AND NOT a AND b;   (* 0 → 2: /a * b *)
G1_T3 := G1_X1 AND c;   (* 1 → 3: c *)
G1_T4 := G1_X2 AND c;   (* 2 → 3: c *)
G1_T5 := G1_X3;   (* 3 → 0: 1 *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
G1_X0 := (G1_X0 AND NOT (G1_T1 OR G1_T2)) OR G1_T5 OR Init;   (* G1 step 0 *)
G1_X1 := (G1_X1 AND NOT G1_T3) OR G1_T1;   (* G1 step 1 *)
G1_X2 := (G1_X2 AND NOT G1_T4) OR G1_T2;   (* G1 step 2 *)
G1_X3 := (G1_X3 AND NOT G1_T5) OR G1_T3 OR G1_T4;   (* G1 step 3 *)

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text > enclosing step 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    auto : BOOL;
    b : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    Modes_X0 : BOOL;   (* Modes step 0, initial *)
    Modes_X1 : BOOL;   (* Modes step 1, enclosing *)
    Modes_X1_M : BOOL;   (* activity at the previous scan *)
    Auto_X20 : BOOL;   (* Auto step 20 *)
    Auto_X21 : BOOL;   (* Auto step 21 *)
    Modes_T1 : BOOL;
    Modes_T2 : BOOL;
    Auto_T1 : BOOL;
    Auto_T2 : BOOL;
END_VAR

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
Modes_T1 := Modes_X0 AND auto;   (* 0 → 1: auto *)
Modes_T2 := Modes_X1 AND NOT auto;   (* 1 → 0: /auto *)
Auto_T1 := Auto_X20 AND b AND Modes_X1;   (* 20 → 21: b *)
Auto_T2 := Auto_X21 AND NOT b AND Modes_X1;   (* 21 → 20: /b *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
Modes_X0 := (Modes_X0 AND NOT Modes_T1) OR Modes_T2 OR Init;   (* Modes step 0 *)
Modes_X1 := (Modes_X1 AND NOT Modes_T2) OR Modes_T1;   (* Modes step 1 *)
Auto_X20 := ((Auto_X20 AND NOT Auto_T1) OR Auto_T2) AND Modes_X1 OR (Modes_X1 AND NOT Modes_X1_M);   (* Auto step 20 *)
Auto_X21 := ((Auto_X21 AND NOT Auto_T2) OR Auto_T1) AND Modes_X1;   (* Auto step 21 *)

(* Stored actions *)
Modes_X1_M := Modes_X1;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text > forcing orders 1`] = `
"(*
  Test cell: Structured Text generated by GrafcetMaker 1.0.0
  generated – review before use
  2026-01-02 03:04 UTC · revision B · QA

  Execution: one clearing level per scan. A sequence of transitions that are all true is crossed
  one transition per scan (IEC 60848 crosses them in one evolution). Edges and timers are
  updated at the end of the scan and seen by the transitions of the next scan.
  Stored actions run when a step changes between two scans; forcing orders take effect in the
  scan after their step becomes active. Call this function block cyclically.
*)
FUNCTION_BLOCK FB_Test_cell
VAR_INPUT
    run : BOOL;
    stop : BOOL;
END_VAR
VAR (* GRAFCET state *)
    Init : BOOL := TRUE;   (* first scan *)
    Safety_X0 : BOOL;   (* Safety step 0, initial *)
    Safety_X1 : BOOL;   (* Safety step 1 *)
    Safety_X2 : BOOL;   (* Safety step 2 *)
    Safety_X3 : BOOL;   (* Safety step 3 *)
    Cycle_X10 : BOOL;   (* Cycle step 10, initial *)
    Cycle_X11 : BOOL;   (* Cycle step 11 *)
    Safety_T1 : BOOL;
    Safety_T2 : BOOL;
    Safety_T3 : BOOL;
    Safety_T4 : BOOL;
    Cycle_T1 : BOOL;
    Cycle_T2 : BOOL;
    Safety_F1 : BOOL;
    Safety_F2 : BOOL;
    Safety_F3 : BOOL;
    Cycle_Forced : BOOL;
END_VAR

(* Forcing orders of the steps active at the start of the scan *)
Safety_F1 := Safety_X1;   (* Cycle{11} *)
Safety_F2 := Safety_X2;   (* Cycle{*} *)
Safety_F3 := Safety_X3;   (* Cycle{INIT} *)
Cycle_Forced := Safety_F1 OR Safety_F2 OR Safety_F3;

(* Transitions: enabled and receptivity true (all from the situation at the start of the scan) *)
Safety_T1 := Safety_X0 AND stop;   (* 0 → 1: stop *)
Safety_T2 := Safety_X1 AND NOT stop;   (* 1 → 2: /stop *)
Safety_T3 := Safety_X2;   (* 2 → 3: 1 *)
Safety_T4 := Safety_X3 AND run;   (* 3 → 0: run *)
Cycle_T1 := Cycle_X10 AND run AND NOT Cycle_Forced;   (* 10 → 11: run *)
Cycle_T2 := Cycle_X11 AND NOT run AND Safety_X1 AND NOT Cycle_Forced;   (* 11 → 10: /run * X1 *)

(* Steps: activated by an incoming transition, deactivated by an outgoing one *)
Safety_X0 := (Safety_X0 AND NOT Safety_T1) OR Safety_T4 OR Init;   (* Safety step 0 *)
Safety_X1 := (Safety_X1 AND NOT Safety_T2) OR Safety_T1;   (* Safety step 1 *)
Safety_X2 := (Safety_X2 AND NOT Safety_T3) OR Safety_T2;   (* Safety step 2 *)
Safety_X3 := (Safety_X3 AND NOT Safety_T4) OR Safety_T3;   (* Safety step 3 *)
Cycle_X10 := (Cycle_X10 AND NOT Cycle_T1) OR Cycle_T2 OR Init;   (* Cycle step 10 *)
Cycle_X11 := (Cycle_X11 AND NOT Cycle_T2) OR Cycle_T1;   (* Cycle step 11 *)

(* Forcing *)
IF Safety_F1 THEN
    Cycle_X10 := FALSE;
    Cycle_X11 := TRUE;
END_IF;
(* Safety_F2: Cycle frozen (its transitions are disabled) *)
IF Safety_F3 THEN
    Cycle_X10 := TRUE;
    Cycle_X11 := FALSE;
END_IF;

Init := FALSE;

END_FUNCTION_BLOCK
"
`;

exports[`Structured Text > macro-step 1`] = `
"(*
